# Password for the web UI (user "admin"). Required: the UI shows your SMS.
SMSC_UI_PASSWORD=change-me

# Optional: a Telegram summary after each live run and an alert when one fails.
SMSC_TELEGRAM_TOKEN=
SMSC_TELEGRAM_CHAT_ID=

# Optional: http://, https:// or socks5:// proxy, only if Google is unreachable directly.
SMSC_PROXY=

# Host port for the UI.
SMSC_PORT=8085
# Time zone for schedules and timestamps.
TZ=Asia/Tehran
# Owner of ./data on the host (run `id` to see yours).
PUID=1000
PGID=1000
# Image tag: latest, or a release such as 1.0.12 to stay on it.
SMSC_VERSION=latest
